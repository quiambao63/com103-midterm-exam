# SPORT QUICK TRACKER

# Sports list
sports = [
    ("Basketball", "Team"),
    ("Volleyball", "Team"),
    ("Badminton", "Individual"),
    ("Chess", "Individual"),
    ("Table Tennis", "Individual")
]

# Function to get non-empty input
def get_non_empty(prompt):
    while True:
        value = input(prompt).strip()
        if value != "":
            return value
        else:
            print("Input cannot be empty. Please try again.")

# Function to get valid sport number
def get_valid_sport():
    while True:
        choice = input("Enter sport number (1-5) or 0 to skip: ")
        if choice.isdigit():
            choice = int(choice)
            if 0 <= choice <= 5:
                return choice
        print("Invalid input. Please enter a number from 0 to 5.")

# Function to get valid result
def get_valid_result():
    while True:
        result = input("Enter result (W for Win, L for Loss): ").upper()
        if result == "W" or result == "L":
            return result
        print("Invalid input. Please enter W or L only.")

# Ask for section and coordinator
section = get_non_empty("Enter class section name: ")
coordinator = get_non_empty("Enter sports coordinator name: ")

# Display sports list
print("\n--- SPORTS EVENTS LIST ---")
for i in range(len(sports)):
    print(f"{i+1}. {sports[i][0]} ({sports[i][1]})")

# Store game entries
games = []

# Accept 4 game entries
for i in range(4):
    print(f"\nGame Entry #{i+1}")
    sport_num = get_valid_sport()

    if sport_num == 0:
        print("Game skipped.")
        continue

    sport_name, category = sports[sport_num - 1]
    opponent = get_non_empty("Enter opposing section name: ")
    result = get_valid_result()

    # Assign points
    points = 3 if result == "W" else 0

    # Store data
    games.append((sport_name, category, opponent, result, points))

# Compute total points
total_points = 0
for game in games:
    total_points += game[4]

# Determine standing
if total_points >= 9:
    standing = "GOLD CONTENDER"
elif total_points >= 6:
    standing = "SILVER PUSH"
else:
    standing = "KEEP FIGHTING!"

# Print results board
print("\n===== GAME RESULTS BOARD =====")
print("Section:", section)
print("Coordinator:", coordinator)
print("\nGames Played:")

if len(games) == 0:
    print("No games recorded.")
else:
    for i in range(len(games)):
        g = games[i]
        print(f"{i+1}. {g[0]} ({g[1]})")
        print(f"   Opponent: {g[2]}")
        print(f"   Result: {g[3]}")
        print(f"   Points: {g[4]}")

print("\nTotal Points:", total_points)
print("Standing:", standing)
