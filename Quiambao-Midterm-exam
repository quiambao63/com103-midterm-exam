# SPORTS QUICK TRACKER
# Sports data
sports = ["Basketball", "Volleyball", "Badminton", "Chess", "Table Tennis"]
categories = ["Team", "Team", "Individual", "Individual", "Individual"]

# Function to make sure input is NOT empty
def get_non_empty(prompt):
    while True:
        value = input(prompt).strip()
        if value == "":
            print("Input cannot be empty. Please try again.")
        else:
            return value

# Function to validate W/L input
def get_result():
    while True:
        result = input("Enter result (W for Win / L for Loss): ").strip()
        if result == "W" or result == "L":
            return result
        else:
            print("Invalid input. Use CAPITAL LETTER only (W or L).")

# Function to validate sport number
def get_sport_number():
    while True:
        try:
            num = int(input("Enter sport number (1-5) or 0 to skip: "))
            if 0 <= num <= 5:
                return num
            else:
                print("Invalid number. Choose from 1–5 or 0 to skip.")
        except:
            print("Invalid input. Enter numbers only.")

# Get basic info
section = get_non_empty("Enter class section name: ")
coordinator = get_non_empty("Enter sports coordinator name: ")

# Display sports list
print("\nSPORTS EVENTS LIST:")
for i in range(len(sports)):
    print(f"{i+1}. {sports[i]} ({categories[i]})")

# Store game results
games = []
total_points = 0

# Accept 4 entries
for i in range(4):
    print(f"\nGame Entry {i+1}")
    
    sport_num = get_sport_number()
    
    if sport_num == 0:
        print("Game skipped.")
        continue
    
    opponent = get_non_empty("Enter opposing section name: ")
    result = get_result()
    
    # Assign points
    if result == "W":
        points = 3
    else:
        points = 0
    
    total_points += points
    
    # Save game data
    games.append([
        sports[sport_num - 1],
        categories[sport_num - 1],
        opponent,
        result,
        points
    ])

# Determine standing
if total_points >= 9:
    standing = "GOLD CONTENDER"
elif total_points >= 6:
    standing = "SILVER PUSH"
else:
    standing = "KEEP FIGHTING!"

# Display results
print("\n" + "="*40)
print("        GAME RESULTS BOARD")
print("="*40)
print(f"Section: {section}")
print(f"Coordinator: {coordinator}\n")

if len(games) == 0:
    print("No games recorded.")
else:
    for i in range(len(games)):
        game = games[i]
        print(f"Game {i+1}: {game[0]} ({game[1]})")
        print(f"  Opponent: {game[2]}")
        print(f"  Result: {game[3]}")
        print(f"  Points: {game[4]}\n")

print(f"TOTAL POINTS: {total_points}")
print(f"STANDING: {standing}")
print("="*40)

print("-" * 60)
print("Total Points :", total_points)
print("Standing     :", standing)
print("=" * 60)
