# Sports Data
sports = [
    ["Basketball", "Team"],
    ["Volleyball", "Team"],
    ["Badminton", "Individual"],
    ["Chess", "Individual"],
    ["Table Tennis", "Individual"]
]

# Ask user info
section = input("Enter class section name: ")
coordinator = input("Enter sports coordinator's name: ")

# Show sports list using loop
print("\n=== SPORTS EVENTS LIST ===")
for i in range(len(sports)):
    print(i + 1, "-", sports[i][0], "(", sports[i][1], ")")

# Lists for saved entries
games = []

# Accept 4 game entries
for entry in range(1, 5):
    print("\nGame Entry", entry)

    sport_num = input("Enter sport number (1-5) or 0 to skip: ")

    # Check if number
    if not sport_num.isdigit():
        print("Invalid input. Slot skipped.")
        continue

    sport_num = int(sport_num)

    # Skip slot
    if sport_num == 0:
        print("Game slot skipped.")
        continue

    # Valid sport number
    if 1 <= sport_num <= 5:
        opponent = input("Enter opposing section name: ")
        result = input("Enter result (W/L): ").upper()

        if result == "W":
            points = 3
        elif result == "L":
            points = 0
        else:
            print("Invalid result. Automatically set to Loss.")
            result = "L"
            points = 0

        # Save data
        games.append([
            sports[sport_num - 1][0],   # sport
            sports[sport_num - 1][1],   # category
            opponent,
            result,
            points
        ])

    else:
        print("Invalid sport number. Slot skipped.")

# Compute total points
total = 0
for game in games:
    total += game[4]

# Determine standing
if total >= 9:
    standing = "GOLD CONTENDER"
elif total >= 6:
    standing = "SILVER PUSH"
else:
    standing = "KEEP FIGHTING!"

# Output board
print("\n==============================")
print("      SPORT QUICK TRACKER")
print("==============================")
print("Section Name :", section)
print("Coordinator  :", coordinator)

print("\nLogged Games:")
print("No. | Sport         | Category   | Opponent      | Result | Points")

for i in range(len(games)):
    print(
        str(i + 1).ljust(4), "|",
        games[i][0].ljust(13), "|",
        games[i][1].ljust(10), "|",
        games[i][2].ljust(13), "|",
        games[i][3].ljust(6), "|",
        games[i][4]
    )

print("\nTotal Points :", total)
print("Standing     :", standing)
print("==============================")
