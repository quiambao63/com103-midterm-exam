# Sport Quick Tracker

# Sports data
sports = [
    ["Basketball", "Team"],
    ["Volleyball", "Team"],
    ["Badminton", "Individual"],
    ["Chess", "Individual"],
    ["Table Tennis", "Individual"]
]

# Ask for class section name
while True:
    section = input("Enter Class Section Name: ").strip()
    if section != "":
        break
    print("Section name cannot be empty.")

# Ask for coordinator name
while True:
    coordinator = input("Enter Sports Coordinator Name: ").strip()
    if coordinator != "":
        break
    print("Coordinator name cannot be empty.")

# Display sports list
print("\n=== SPORTS EVENTS LIST ===")
for i in range(len(sports)):
    print(i + 1, "-", sports[i][0], "-", sports[i][1])

games = []
total_points = 0

# Accept 4 game entries
for entry in range(1, 5):
    print("\nGame Entry", entry)

    while True:
        sport_num = input("Enter Sport Number (1-5) or 0 to skip: ")

        if sport_num.isdigit():
            sport_num = int(sport_num)

            if sport_num == 0:
                print("Game slot skipped.")
                break

            elif 1 <= sport_num <= 5:
                opponent = input("Enter Opposing Section Name: ").strip()

                while opponent == "":
                    print("Opponent name cannot be empty.")
                    opponent = input("Enter Opposing Section Name: ").strip()

                while True:
                    result = input("Enter Result (W/L): ")

                    if result == "W":
                        points = 3
                        break
                    elif result == "L":
                        points = 0
                        break
                    else:
                        print("Invalid. Use capital W or L only.")

                games.append([
                    sports[sport_num - 1][0],
                    sports[sport_num - 1][1],
                    opponent,
                    result,
                    points
                ])

                total_points += points
                break

            else:
                print("Invalid sport number. Choose 1 to 5.")

        else:
            print("Invalid input. Numbers only.")

# Determine standing
if total_points >= 9:
    standing = "GOLD CONTENDER"
elif total_points >= 6:
    standing = "SILVER PUSH"
else:
    standing = "KEEP FIGHTING!"

# Print Results Board
print("\n" + "=" * 60)
print("              SPORT QUICK TRACKER RESULTS")
print("=" * 60)
print("Section Name :", section)
print("Coordinator  :", coordinator)
print("-" * 60)

if len(games) == 0:
    print("No games logged.")
else:
    print("No.  Sport           Category      Opponent      Result Points")
    print("-" * 60)

    for i in range(len(games)):
        print(
            str(i + 1).ljust(4),
            games[i][0].ljust(15),
            games[i][1].ljust(13),
            games[i][2].ljust(12),
            games[i][3].ljust(6),
            games[i][4]
        )

print("-" * 60)
print("Total Points :", total_points)
print("Standing     :", standing)
print("=" * 60)
