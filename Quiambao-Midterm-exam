# Sport Quick Tracker
# Sports data
sports = [
    ["Basketball", "Team"],
    ["Volleyball", "Team"],
    ["Badminton", "Individual"],
    ["Chess", "Individual"],
    ["Table Tennis", "Individual"]
]

# Ask user info
section = input("Enter class section name: ")
coordinator = input("Enter sports coordinator's name: ")

# Display sports list
print("\nSPORTS EVENTS LIST")
for i in range(len(sports)):
    print(i + 1, "-", sports[i][0], "-", sports[i][1])

# Lists for storing game records
game_sport = []
game_category = []
game_opponent = []
game_result = []
game_points = []

# Accept 4 game entries
for slot in range(1, 5):
    print("\nGame Entry", slot)
    num = int(input("Enter sport number (1-5) or 0 to skip: "))

    if num == 0:
        print("Game slot skipped.")
    elif num >= 1 and num <= 5:
        opponent = input("Enter opposing section name: ")
        result = input("Enter result (W/L): ").upper()

        if result == "W":
            points = 3
        else:
            points = 0

        game_sport.append(sports[num - 1][0])
        game_category.append(sports[num - 1][1])
        game_opponent.append(opponent)
        game_result.append(result)
        game_points.append(points)
    else:
        print("Invalid sport number.")

# Compute total points
total = 0
for p in game_points:
    total = total + p

# Determine standing
if total >= 9:
    standing = "GOLD CONTENDER"
elif total >= 6:
    standing = "SILVER PUSH"
else:
    standing = "KEEP FIGHTING!"

# Print results board
print("\n==============================")
print("      GAME RESULTS BOARD")
print("==============================")
print("Section Name :", section)
print("Coordinator  :", coordinator)
print("------------------------------")

if len(game_sport) == 0:
    print("No games logged.")
else:
    for i in range(len(game_sport)):
        print("Game", i + 1)
        print("Sport     :", game_sport[i])
        print("Category  :", game_category[i])
        print("Opponent  :", game_opponent[i])
        print("Result    :", game_result[i])
        print("Points    :", game_points[i])
        print("------------------------------")

print("Total Points :", total)
print("Standing     :", standing)
print("==============================")
